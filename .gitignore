# Dependencies
node_modules/

# Build output
dist/
build/
coverage/
*.tsbuildinfo

# Local config and secrets — never commit these
.env
.env.*
!.env.example
*.local
radicale-data/
*.ics.local

# Logs
*.log
npm-debug.log*

# Editors / OS
.vscode/*
!.vscode/extensions.json
.idea/
*.swp
.DS_Store
Thumbs.db

# Claude local settings
.claude/settings.local.json
CLAUDE.local.md

# Built app embedded into the gateway. The directory must be re-included
# first (dist/ above ignores it), then only the placeholder README is kept,
# so `go vet` and `go test` work on a clean checkout.
!gateway/cmd/haken/dist/
gateway/cmd/haken/dist/*
!gateway/cmd/haken/dist/README
test-results/
playwright-report/
e2e-data/
deploy/radicale/
