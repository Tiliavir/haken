# Copy to deploy/radicale/config/config. Users: htpasswd with bcrypt
# (htpasswd -B -c deploy/radicale/config/users <user>).
[server]
hosts = 0.0.0.0:5232

[auth]
type = htpasswd
htpasswd_filename = /config/users
htpasswd_encryption = bcrypt

[rights]
type = owner_only

[storage]
filesystem_folder = /data/collections
